{
  "name": "@zavx0z/chat",
  "label": "Chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Переиспользуемый frontend бесед: ограниченная история, сообщения, ввод и медиа, независимо от backend и агентных систем",
  "exports": {
    "./history": "./conversation/history/index.ts",
