    "./composer": "./conversation/message/composer/index.tsx",
    "./content": "./conversation/message/view/index.tsx",
    "./media": "./conversation/media/browser.ts",
    "./conversation": "./conversation/index.ts",
    "./user": "./user/index.ts",
    "./message": "./conversation/message/index.ts",
    "./header": "./conversation/header/index.tsx",
    "./conversations": "./conversation/list/index.tsx",
    "./surface": "./conversation/view/index.tsx",
    "./bubble": "./conversation/message/bubble/index.tsx"
  },
  "scripts": {
    "test": "bun test ./conversation",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@zavx0z/immersive": "^0.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@zavx0z/immersive": "link:@zavx0z/immersive"
  }
